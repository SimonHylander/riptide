# Copy to apps/web/.env.local (gitignored). Server-only: AuthKit reads these from process.env at request time.
# WorkOS dashboard > API Keys
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...
# Must match the Redirect URI in the WorkOS dashboard and the /callback route.
WORKOS_REDIRECT_URI=http://localhost:3000/callback
# At least 32 characters: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=

# Optional. Defaults to CONVEX_URL from packages/backend/.env.local.
# VITE_CONVEX_URL=https://<deployment>.convex.cloud
